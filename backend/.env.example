SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
RESET_PASSWORD_EXPIRE_MINUTES=30
DATABASE_URL=sqlite:///./data/crm.db
FRONTEND_URL=http://localhost:5173

# Mailtrap SMTP
SMTP_HOST=live.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=api
SMTP_PASSWORD=replace-with-your-mailtrap-token
SMTP_FROM_EMAIL=noreply@crmevent.fr
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Notifications and reminders
NOTIFICATION_SYNC_INTERVAL_SECONDS=900
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SEVERITIES=warning,error
